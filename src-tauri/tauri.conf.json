{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uttr",
  "version": "0.2.1",
  "identifier": "ai.letsdecode.uttr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "flowbar",
        "title": "uttr Flow Bar",
        "url": "flowbar.html",
        "width": 220,
        "height": 56,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/catalog.json"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "publisher": "Lets Decode AI",
    "copyright": "Copyright (c) 2026 Lets Decode AI",
    "category": "Productivity",
    "shortDescription": "Local, private push-to-talk dictation",
    "longDescription": "uttr types what you say into any app. Speech recognition runs entirely on your device using sherpa-onnx models such as NVIDIA Parakeet."
  }
}
