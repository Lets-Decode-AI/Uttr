<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Signed builds use the hardened runtime, which blocks the microphone
       (with no permission prompt) unless the app declares this entitlement. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
